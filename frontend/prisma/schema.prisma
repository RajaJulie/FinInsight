// Decrit les modeles, enums, relations, index et contraintes Prisma de FinInsight.
// Sert de reference pour generer le client et preparer les evolutions du schema PostgreSQL.

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  CREDIT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum RecurringFrequency {
  MONTHLY
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum GoalEntryType {
  ALLOCATION
  RELEASE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  transactions             Transaction[]
  categories               Category[]
  accounts                 Account[]
  budgets                  Budget[]
  recurringTransactions    RecurringTransaction[]
  monthlyEmergencyReserves MonthlyEmergencyReserve[]
  savingsGoals             SavingsGoal[]
}

model Transaction {
  id                   String          @id @default(cuid())
  title                String
  amount               Float
  type                 TransactionType
  category             String
  categoryId           String?
  accountId            String?
  destinationAccountId String?
  date                 DateTime        @default(now())

  userId             String
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRelation   Category?                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account            Account?                     @relation("SourceAccountTransactions", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount Account?                     @relation("DestinationAccountTransfers", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  recurringSources   RecurringTransactionSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([categoryId])
  @@index([accountId])
  @@index([destinationAccountId])
}

model Category {
  id        String          @id @default(cuid())
  name      String
  type      TransactionType
  icon      String
  color     String
  isDefault Boolean         @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Budget {
  id     String @id @default(cuid())
  amount Float
  month  Int
  year   Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@index([categoryId])
}

model MonthlyEmergencyReserve {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(12, 2)
  month  Int
  year   Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
}

model Account {
  id             String        @id @default(cuid())
  name           String
  type           AccountType
  initialBalance Float         @default(0)
  currency       String        @default("EUR")
  icon           String
  color          String
  status         AccountStatus @default(ACTIVE)
  isPrimary      Boolean       @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]          @relation("SourceAccountTransactions")
  incomingTransfers     Transaction[]          @relation("DestinationAccountTransfers")
  recurringTransactions RecurringTransaction[]
  savingsGoals          SavingsGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, status])
}

model RecurringTransaction {
  id         String             @id @default(cuid())
  title      String
  amount     Decimal @db.Decimal(12, 2)
  type       TransactionType
  frequency  RecurringFrequency @default(MONTHLY)
  dayOfMonth Int
  active     Boolean            @default(true)
  startDate  DateTime
  endDate    DateTime?

  detectionTitleNorm String?
  detectionAccountId String?
  detectionType      TransactionType?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  sourceTransactions RecurringTransactionSource[]
  activityPeriods    RecurringActivityPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@index([userId, frequency])
  @@index([detectionType, detectionTitleNorm, detectionAccountId])
  @@index([categoryId])
  @@index([categoryId, startDate, endDate])
  @@index([accountId])
}

model RecurringActivityPeriod {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime?
  amount    Decimal  @db.Decimal(12, 2)
  cancelled Boolean  @default(false)
  accountId String?
  dayOfMonth Int?

  recurringTransactionId String
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([recurringTransactionId, startDate])
}

model RecurringTransactionSource {
  id String @id @default(cuid())

  recurringTransactionId String
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([recurringTransactionId, transactionId])
  @@unique([transactionId])
  @@index([transactionId])
}

model SavingsGoal {
  id           String            @id @default(cuid())
  title        String
  targetAmount Decimal           @db.Decimal(12, 2)
  targetDate   DateTime?
  status       SavingsGoalStatus @default(ACTIVE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  entries GoalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([accountId])
}

model GoalEntry {
  id             String        @id @default(cuid())
  type           GoalEntryType
  amount         Decimal       @db.Decimal(12, 2)
  effectiveAt    DateTime      @default(now())
  note           String?
  idempotencyKey String

  goalId String
  goal   SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([goalId, idempotencyKey])
  @@index([goalId, effectiveAt])
}
